/dts-v1/;
/plugin/;

/* From the supplied BOE/GT911 ZIP: keep the DSI1/TCA9555 wiring, replace
 * the panel and I2C client with ILI79505A. P04 enables the +/-5.8 V bias.
 */
/ {
    compatible = "brcm,bcm2711";

    fragment@0 {
        target-path = "/soc/i2c0mux/i2c@1";
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            gpioexp: gpio@20 {
                compatible = "nxp,pca9555";
                reg = <0x20>;
                gpio-controller;
                #gpio-cells = <2>;
                gpio-line-names = "LCD_RST", "LCD_EN", "TP_RST",
                                  "TP_INT", "LCD_BIAS_EN";
            };

            ilitek: touchscreen@41 {
                compatible = "tchip,ilitek";
                reg = <0x41>;
                touch,reset-gpio = <&gpioexp 2 0>;
                touch,irq-gpio = <&gpioexp 3 0>;
            };
        };
    };

    fragment@1 {
        target = <&dsi1>;
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            panel: panel@0 {
                compatible = "ilitek,ili79505a-panel";
                reg = <0>;
                reset-gpios = <&gpioexp 0 1>;
                backlight-gpios = <&gpioexp 1 0>;
                power-gpios = <&gpioexp 4 0>;

                port {
                    panel_in: endpoint {
                        remote-endpoint = <&dsi1_out>;
                    };
                };
            };

            port {
                dsi1_out: endpoint {
                    remote-endpoint = <&panel_in>;
                    data-lanes = <0 1>;
                };
            };
        };
    };

    fragment@2 {
        target = <&spidev0>;
        __overlay__ { status = "disabled"; };
    };
};
